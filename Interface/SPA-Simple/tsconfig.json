{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@app/*": ["./src/*"],
      "@root/*": ["./*"]
    },
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "lib": ["ESNext"],
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "target": "esnext"
  },
  "include": ["./src/**/*"],
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
